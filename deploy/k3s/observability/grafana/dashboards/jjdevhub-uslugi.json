{
  "uid": "jjdevhub-uslugi",
  "title": "jjdevhub-uslugi",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service_name",
        "label": "service_name",
        "type": "custom",
        "hide": 0,
        "includeAll": false,
        "multi": true,
        "current": {
          "selected": true,
          "text": ["identity", "news", "learning", "cv", "contact", "gateway", "web"],
          "value": ["identity", "news", "learning", "cv", "contact", "gateway", "web"]
        },
        "options": [
          { "selected": true, "text": "identity", "value": "identity" },
          { "selected": true, "text": "news", "value": "news" },
          { "selected": true, "text": "learning", "value": "learning" },
          { "selected": true, "text": "cv", "value": "cv" },
          { "selected": true, "text": "contact", "value": "contact" },
          { "selected": true, "text": "gateway", "value": "gateway" },
          { "selected": true, "text": "web", "value": "web" }
        ],
        "query": "identity,news,learning,cv,contact,gateway,web"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "$service_name",
      "repeat": "service_name",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": [
        {
          "id": 1,
          "type": "timeseries",
          "title": "$service_name żądania w toku",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
          "fieldConfig": { "defaults": {}, "overrides": [] },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
            "tooltip": { "mode": "single", "sort": "none" }
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "expr": "jjdevhub:http_server_active_requests:sum{service_name=\"$service_name\"}",
              "legendFormat": "{{service_name}}"
            }
          ]
        },
        {
          "id": 2,
          "type": "timeseries",
          "title": "$service_name czas odpowiedzi",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "links": [
                {
                  "title": "Jaeger",
                  "url": "",
                  "internal": {
                    "datasourceUid": "jaeger",
                    "datasourceName": "Jaeger",
                    "datasource": { "type": "jaeger", "uid": "jaeger" },
                    "query": {
                      "refId": "A",
                      "query": "${__data.fields.trace_id}"
                    }
                  }
                }
              ]
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
            "tooltip": { "mode": "single", "sort": "none" }
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service_name\"}[5m])))",
              "legendFormat": "p95"
            }
          ]
        }
      ]
    }
  ]
}

# Copy to infra/docker/.env for local Compose (gitignored).
# On the server use /etc/jjdevhub/api.env (chmod 600) instead — not in the clone.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=identity_write

# Path to the RSA private key on the host. Generate and encrypt with sops;
# the plaintext file does not belong in git. Empty in Development uses an in-memory key.
JWT_SIGNING_KEY_PATH=
JWT_ISSUER=JJDevHub
JWT_AUDIENCE=JJDevHub
JWT_EXPIRY_MINUTES=60

# Development exposes /openapi. Production on the server.
ASPNETCORE_ENVIRONMENT=Development

# Traces only. Empty uses the Compose default http://jaeger:4317.
# Jaeger does not accept OTLP metrics or logs. Do not point those signals at it.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional traces override. When set, it wins over OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Set only for a collector that accepts that signal. Empty = no OTLP push.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=JJDevHub.Api

# Grafana admin. Leave the password empty in git. Set it in infra/docker/.env
# (or /etc/jjdevhub/api.env on the VM): openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Public UI on the Cloudflare tunnel. Compose defaults to these hostnames when
# the variables are unset, which is what the VM should do.
# Local infra/docker/.env overrides them to localhost — see the comments below.
# GRAFANA_ROOT_URL=https://grafana.jjdevhub.com/
# GRAFANA_DOMAIN=grafana.jjdevhub.com
# PROMETHEUS_EXTERNAL_URL=https://prometheus.jjdevhub.com/
# Jaeger UI is https://jaeger.jjdevhub.com/ (tunnel → 127.0.0.1:16686). No env key.
